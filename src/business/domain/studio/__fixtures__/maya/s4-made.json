{"durationMs": 34910, "beats": [{"text": "At the open field, Pip zigzags through the tall grass with Maya's ball.", "startMs": 130, "endMs": 5392, "words": [[0, 2, 130, 130], [3, 6, 390, 650], [7, 11, 700, 1000], [12, 18, 1020, 1515], [19, 22, 1833, 2210], [23, 30, 2220, 3030], [31, 38, 3041, 3250], [39, 42, 3260, 3360], [43, 47, 3454, 3820], [48, 53, 3860, 4289], [54, 58, 4290, 4550], [59, 65, 4550, 4940], [66, 71, 4980, 5392]]}, {"text": "Tobi, go left! I'll go right!", "startMs": 7592, "endMs": 9903, "words": [[0, 5, 7592, 8062], [6, 8, 8360, 8490], [9, 14, 8500, 8860], [15, 19, 9310, 9450], [20, 22, 9460, 9610], [23, 29, 9620, 9903]], "who": "Maya"}, {"text": "He's too quick!", "startMs": 12863, "endMs": 13836, "words": [[0, 4, 12863, 13110], [5, 8, 13180, 13380], [9, 15, 13450, 13836]], "who": "Tobi"}, {"text": "There he is, by the goalpost!", "startMs": 14734, "endMs": 16371, "words": [[0, 5, 14734, 14910], [6, 8, 14920, 15040], [9, 12, 15090, 15240], [13, 15, 15458, 15550], [16, 19, 15570, 15640], [20, 29, 15640, 16371]], "who": "Tobi"}, {"text": "Got you, little pup!", "startMs": 18999, "endMs": 20030, "words": [[0, 3, 18999, 19260], [4, 8, 19260, 19300], [9, 15, 19390, 19570], [16, 20, 19622, 20030]], "who": "Maya"}, {"text": "Woof woof!", "startMs": 21029, "endMs": 21776, "words": [[0, 4, 21029, 21445], [5, 10, 21485, 21776]], "who": "Pip"}, {"text": "You got him! And he still has your ball!", "startMs": 22750, "endMs": 25450, "words": [[0, 3, 22750, 22870], [4, 7, 22870, 23220], [8, 12, 23230, 23520], [13, 16, 23902, 24090], [17, 19, 24100, 24140], [20, 25, 24150, 24500], [26, 29, 24510, 24820], [30, 34, 24820, 24950], [35, 40, 24950, 25450]], "who": "Tobi"}, {"text": "He really likes your ball!", "startMs": 26909, "endMs": 28589, "words": [[0, 2, 26909, 27130], [3, 9, 27140, 27720], [10, 15, 27730, 28140], [16, 20, 28140, 28210], [21, 26, 28210, 28589]], "who": "Tobi"}, {"text": "You silly puppy! Let's go home.", "startMs": 29750, "endMs": 32530, "words"