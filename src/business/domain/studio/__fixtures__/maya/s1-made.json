{"durationMs": 35240, "beats": [{"text": "Morning in the compound. The gate is open a crack.", "startMs": 447, "endMs": 4345, "words": [[0, 7, 447, 920], [8, 10, 1030, 1130], [11, 14, 1130, 1290], [15, 24, 1447, 2089], [25, 28, 2753, 2790], [29, 33, 2790, 3210], [34, 36, 3210, 3360], [37, 41, 3431, 3680], [42, 43, 3730, 3769], [44, 50, 3846, 4345]]}, {"text": "Ready, Pip? Catch the ball!", "startMs": 5769, "endMs": 7335, "words": [[0, 6, 5769, 5990], [7, 11, 6170, 6319], [12, 17, 6690, 6950], [18, 21, 6960, 7000], [22, 27, 7000, 7335]], "who": "Maya"}, {"text": "Go, Pip, go!", "startMs": 7920, "endMs": 9810, "words": [[0, 3, 7920, 7920], [4, 8, 8908, 9230], [9, 12, 9445, 9810]], "who": "Maya"}, {"text": "Not the gate, Pip!", "startMs": 10612, "endMs": 11798, "words": [[0, 3, 10612, 10869], [4, 7, 10880, 10950], [8, 13, 10950, 11450], [14, 18, 11724, 11798]], "who": "Maya"}, {"text": "Pip! Where are you going?", "startMs": 13571, "endMs": 15438, "words": [[0, 4, 13571, 13900], [5, 10, 14522, 14710], [11, 14, 14750, 14840], [15, 18, 14850, 14960], [19, 25, 14960, 15438]], "who": "Maya"}, {"text": "Maya, don't go near the road!", "startMs": 16428, "endMs": 18706, "words": [[0, 5, 16428, 16910], [6, 11, 17300, 17650], [12, 14, 17724, 17880], [15, 19, 17890, 18130], [20, 23, 18140, 18240], [24, 29, 18250, 18706]], "who": "Mama Nkechi"}, {"text": "He's so fast!", "startMs": 19676, "endMs": 20671, "words": [[0, 4, 19676, 19830], [5, 7, 19840, 20030], [8, 13, 20040, 20671]], "who": "Maya"}, {"text": "I have to catch him!", "startMs": 21182, "endMs": 22120, "words": [[0, 1, 21182, 21270], [2, 6, 21280, 21510], [7, 9, 21551, 21640], [10, 15, 21700, 21940], [16, 20, 21940, 22120]], "who": "Maya"}, {"text": "I'm coming, Pip!", "startMs": 22859, "endMs": 23759, "words": [[0, 3, 22859, 23000], [4, 11, 23060, 23520], [12, 16, 23720, 23759]], "who": "Maya"}, {"text": "Maya! Wait for me!", "startMs": 25404, "endMs": 26900, "words": [[0, 5, 25404, 25840], [6, 10, 26120, 26400], [11, 