# ── Core ─────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000
# Frontend origin, used for CORS and for links in emails
FRONTEND_URL=http://localhost:3000

# ── MySQL ────────────────────────────────────────────────────────────────────
DATABASE_URL=mysql://root:password@localhost:3307/easyread

# ── Redis (BullMQ queues + SSE pub/sub) ──────────────────────────────────────
REDIS_URL=redis://localhost:6380

# ── Auth ─────────────────────────────────────────────────────────────────────
# Separate secrets so a leaked access secret can't mint refresh tokens.
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30

# ── Provider selection ───────────────────────────────────────────────────────
# Every integration is a port with a local adapter that runs offline and a real
# adapter behind these switches. Flip one only once its keys are present.
STORAGE_DRIVER=local          # local | s3 | drive
# s3 — any S3-compatible bucket (Railway Buckets, R2, MinIO, AWS). Required in
# any deployment where the API and the worker are separate services: neither
# can read the other's disk, and a container's disk is wiped on every deploy.
S3_BUCKET=
S3_ENDPOINT=                  # unset for AWS itself
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true      # false only for AWS S3
CONVERTER_DRIVER=passthrough  # passthrough (PDF only) | drive (free Office->PDF)
LLM_DRIVER=ai                 # ai (real models) | fake (offline stand-in, does NOT simplify)
EMAIL_DRIVER=log              # log only — the Resend adapter is not built yet
PAYMENTS_DRIVER=fake          # fake only — billing is deferred

# Where the local storage adapter keeps uploaded and derived files
STORAGE_ROOT=./storage

# ── Real providers (unused until the driver above is switched) ───────────────
# ── Models (Vercel AI SDK) ───────────────────────────────────────────────────
# Keys for whichever providers your model config below names. A key that is
# named but missing stops the process at boot rather than failing a document.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=

# Mistral's hosted OCR reads whole scanned documents in one call. Unset, the
# pipeline falls back to per-page vision OCR — functional but much slower.
MISTRAL_API_KEY=
# MISTRAL_OCR_MODEL=mistral-ocr-latest

# Every model is `provider:model-id`, e.g.
#   openai:gpt-4o-mini | anthropic:claude-sonnet-4-5 | google:gemini-2.0-flash
AI_MODEL_DEFAULT=openai:gpt-4o-mini

# Per-task overrides, all optional — unset falls back to AI_MODEL_DEFAULT.
# Simplification is the one that matters: it's one call per page, so a 300-page
# document is 300 calls, while a highlight is one.
AI_MODEL_SUMMARIZE=
AI_MODEL_TOPICS=
AI_MODEL_SIMPLIFY_STANDARD=
AI_MODEL_SIMPLIFY_EASIEST=
AI_MODEL_HIGHLIGHT=
AI_MODEL_CHAT=
AI_MODEL_LEARN=
AI_MODEL_VISUALIZE_QUERY=
# Guided reading: the chapter preview (one call per chapter ever — cached),
# the recall grader, and the own-question verdict.
AI_MODEL_PREVIEW=
AI_MODEL_RECALL_GRADE=
AI_MODEL_QUESTION_CHECK=

# Embeddings need a provider that offers them (OpenAI or Google, not Anthropic).
AI_EMBED_MODEL=openai:text-embedding-3-small

# In-call retries. The queue already retries the whole job with backoff, so
# this only needs to cover transient rate limits.
AI_MAX_RETRIES=2

# Optional per-provider overrides for gateways and proxies.
# Leave these commented out rather than blank — the SDK reads them itself
# and rejects an empty value.
# OPENAI_BASE_URL=
# ANTHROPIC_BASE_URL=
# GOOGLE_BASE_URL=


# Base64-encoded (or raw) service-account JSON.
GOOGLE_SERVICE_ACCOUNT_JSON=""
# Optional folder so uploads don't land in the impersonated user's root.
GOOGLE_DRIVE_FOLDER_ID=
# REQUIRED for uploads: a Workspace user to impersonate via domain-wide
# delegation. Service accounts have no Drive storage quota of their own, so
# without this every upload fails with storageQuotaExceeded.
GOOGLE_WORKSPACE_SUBJECT=

RESEND_API_KEY=
EMAIL_FROM=no-reply@easyread.app

# Superseded by Paddle, below. Kept only for reference.
# PAYSTACK_SECRET_KEY=
# PAYSTACK_PUBLIC_KEY=
# PAYSTACK_WEBHOOK_SECRET=

# ── Visualize (image search) ─────────────────────────────────────────────────
# Google Programmable Search. Unset means the Visualize panel shows its
# no-results state rather than fabricating images.
GOOGLE_SEARCH_API_KEY=
GOOGLE_SEARCH_ENGINE_ID=

# ── Retention ────────────────────────────────────────────────────────────────
# Days a soft-deleted document or account survives before the purge job removes
# it for good (PRD §10).
PURGE_AFTER_DAYS=14

# ── Testing switch ───────────────────────────────────────────────────────────
# Lifts every plan limit (documents, Easiest conversions, highlights, page cap,
# export watermark) while leaving the reported plan as-is. For trying the
# product without the plan getting in the way — turn it off before anyone else
# uses this deployment.
FREE_PLAN_UNLIMITED=false

# ── Voice ────────────────────────────────────────────────────────────────────
# Text-to-speech for "listen to this page" and the realtime voice conversation.
# Both ride on OPENAI_API_KEY above. Audio is cached per page, so a page is
# only ever synthesised once per (version, voice, model).
AI_TTS_MODEL=gpt-4o-mini-tts
AI_TTS_VOICE=alloy

# Speech-to-text for guided reading's voice input (recall and answers spoken
# rather than typed). Rides on OPENAI_API_KEY; the transcript is shown to the
# reader for review before anything grades it, and no audio is stored.
AI_STT_MODEL=gpt-4o-mini-transcribe
AI_REALTIME_MODEL=gpt-realtime
AI_REALTIME_VOICE=marin

# ElevenLabs, for the tutors whose voice lives there (see tutors.ts — the
# provider rides on the tutor, not on config). Optional: without a key those
# tutors fall back to their OpenAI voice and everything keeps working. With a
# key, their lessons run on ElevenLabs Agents (a shared agent is provisioned
# automatically on first use) and their intros are synthesised there too.
ELEVENLABS_API_KEY=
# ELEVENLABS_TTS_MODEL=eleven_multilingual_v2
# ELEVENLABS_AGENT_LLM=gpt-4o
# ELEVENLABS_AGENT_TTS_MODEL=eleven_turbo_v2

# ── Billing (Paddle Billing) ─────────────────────────────────────────────────
# Without PADDLE_API_KEY the fake driver is bound and no checkout charges.
PADDLE_ENV=sandbox            # or: production
PADDLE_API_KEY=
PADDLE_WEBHOOK_SECRET=        # from the webhook destination in Paddle
PADDLE_PRICE_MONTHLY=pri_...  # $20/month price id
PADDLE_PRICE_YEARLY=pri_...   # $150/year price id
